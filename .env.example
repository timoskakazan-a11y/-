# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Вариант 1: service_role ключ (ТОЛЬКО на сервере, никогда не публиковать)
SUPABASE_SERVICE_ROLE_KEY=

# Вариант 2 (используется сейчас): публичный ключ + секрет сервера.
# Секрет хранится в private.server_secret (см. supabase/server_access.sql)
SUPABASE_ANON_KEY=
SUPABASE_SERVER_SECRET=

# Пароль для входа в админку /admin
ADMIN_PASSWORD=придумайте-длинный-пароль
# Случайная строка (минимум 32 символа) для подписи сессий и хеширования IP
# Сгенерировать: openssl rand -hex 32
SESSION_SECRET=
