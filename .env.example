# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role ключ: ТОЛЬКО на сервере, никогда не публиковать
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Пароль для входа в админку /admin
ADMIN_PASSWORD=придумайте-длинный-пароль
# Случайная строка (минимум 32 символа) для подписи сессий и хеширования IP
# Сгенерировать: openssl rand -hex 32
SESSION_SECRET=
